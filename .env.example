# The app does not read .env itself (docker compose does). On the Debian server these go in /etc/camchat.env.
PORT=3000
# Where the SQLite database lives (back this directory up). Default ./data
# Public app files (the APK and Windows zip) live in DATA_DIR/downloads and are kept across upgrades.
DATA_DIR=./data
# Random secret for session tokens / device cookies (openssl rand -hex 32). If unset, one is generated in DATA_DIR.
SESSION_SECRET=
# Public URL (used for the Origin check and Google OAuth redirect)
PUBLIC_URL=https://chat.example.com
# Comma list of usernames that are always admin (they still have to register first)
ADMIN_USERNAMES=
# Proxies whose CF-Connecting-IP / X-Forwarded-For headers are trusted (Express syntax)
TRUST_PROXY=loopback,uniquelocal
# -1 = guests can never cam (default), 0 = guests can cam, N = guests can cam after N minutes
# GUEST_CAM_AFTER_MINUTES=-1
# MAX_CONN_PER_IP=10
# REGISTRATIONS_PER_IP_PER_HOUR=5
# REGISTRATION=closed
# WORD_FILTER=word1,word2        (replaces the built-in list; empty disables)
# WORD_FILTER_FILE=/etc/camchat-words.txt
# TURN relay: time-limited credentials (preferred, matches coturn static-auth-secret)
# TURN_URLS=turn:turn.example.com:3478,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349
# TURN_SECRET=
# TURN_TTL=21600
# ...or static credentials (fallback, visible to every browser)
# TURN_USER=camchat
# TURN_PASS=change-me
# Optional Google sign-in
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Optional Discord sign-in (Developer Portal → OAuth2 → redirect URI .../api/auth/discord/callback)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# Shown on /terms and /privacy. Leave unset to tell people to ask a moderator in the app.
# CONTACT_EMAIL=
# Optional TikTok Login Kit (Web). Redirect URI is PUBLIC_URL + /auth/tiktok/callback
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Test-only endpoint overrides. Leave unset in production.
# TIKTOK_AUTHORIZE_URL=
# TIKTOK_TOKEN_URL=
# TIKTOK_USERINFO_URL=
# Comma-separated extra allowed origins for Socket.IO / API (defaults to same-origin)
# CORS_ORIGIN=
# Custom URL scheme the iOS, Android, and Windows apps register for OAuth handoff (see NATIVE_APPS.md).
# NATIVE_AUTH_SCHEME=camchat

# Signup CAPTCHA: built-in math challenge by default. Optional third-party:
# TURNSTILE_SITE_KEY= / TURNSTILE_SECRET=
# HCAPTCHA_SITE_KEY= / HCAPTCHA_SECRET=
# Mail. Resend is the primary sender. SMTP is the fallback (587 STARTTLS, 465 implicit TLS).
# RESEND_API_KEY=
# MAIL_FROM=zeronoise <no-reply@mail.nano11bravo.com>
# EMAIL_VERIFY_REQUIRED=0
# SMTP_HOST= SMTP_PORT=587 SMTP_USER= SMTP_PASS= SMTP_FROM=noreply@example.com
# SMTP_IMPLICIT_TLS=1
# Operator copy of password-reset requests (still sent when SMTP is configured):
# SMTP_NOTIFY_EMAIL=admin@example.com

# GIF search (server proxy; keys are not sent to browsers). Tenor is used if set, otherwise Giphy.
# Create keys at https://developers.google.com/tenor and https://developers.giphy.com
# TENOR_API_KEY=
# GIPHY_API_KEY=

# Meld Custom RTMP. The dialog shows rtmp://HOST:PORT/live. The stream key is the same secret as WHIP.
# Default host is rtmp.nano11bravo.com (port 1935 is forwarded). Do not use the Cloudflare web hostname.
# RTMP_PUBLIC_HOST=rtmp.nano11bravo.com
# RTMP_PORT=1935
